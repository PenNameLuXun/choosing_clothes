POSTGRES_DB=choosing_clothes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=55432

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

NEXT_PUBLIC_API_BASE_URL=http://localhost:8765
NEXT_PUBLIC_STORAGE_BASE_URL=http://localhost:9000

API_PORT=8765
WORKER_LOG_LEVEL=INFO

# 本地开发默认使用 SQLite，无需启动 Docker
# 生产/集成测试时换成 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:55432/choosing_clothes
DATABASE_URL=sqlite:///./dev.db

# AI 试穿（IDM-VTON via Replicate）
# 在 https://replicate.com/account/api-tokens 获取
REPLICATE_API_TOKEN=
